{
  "name": "supertitle-cuer",
  "productName": "Supertitle Cuer",
  "version": "2.5.2",
  "description": "Cue opera supertitles from the score: number the cues on your PDF score, pair them with slides, and run them to a projector with one key.",
  "author": "Poetic PiXie",
  "homepage": "https://github.com/poetic-pixie/supertitle-cuer",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:html": "node scripts/build-html.js",
    "start": "npm run build:html && electron .",
    "dist:mac": "npm run build:html && electron-builder --mac",
    "dist:win": "npm run build:html && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "pptxgenjs": "^3.12.0"
  },
  "build": {
    "appId": "com.poeticpixie.supertitlecuer",
    "productName": "Supertitle Cuer",
    "copyright": "© Poetic PiXie",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/Supertitle_Cuer.html",
      "package.json",
      "docs/Supertitle_Cuer_Manual.pdf"
    ],
    "afterPack": "build/afterPack.js",
    "publish": null,
    "fileAssociations": [
      {
        "ext": "supertitles",
        "name": "Supertitles Project",
        "description": "Supertitle Cuer project",
        "role": "Editor",
        "mimeType": "application/x-supertitles",
        "rank": "Owner"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "identity": null,
      "minimumSystemVersion": "12.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Supertitle_Cuer-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Supertitle Cuer listens to the music to count down to the next cue (Follow), and records reference runs."
      }
    },
    "dmg": {
      "title": "Supertitle Cuer ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Supertitle_Cuer-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Supertitle Cuer"
    }
  }
}
